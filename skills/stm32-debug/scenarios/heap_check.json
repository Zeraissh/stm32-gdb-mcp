{
  "name": "heap_check",
  "description": "Check for FreeRTOS heap exhaustion / leak. Replace HEAP_FREE_SYMBOL with the free-heap variable (e.g. xFreeBytesRemaining).",
  "steps": [
    {"tool": "self_check", "args": {}},
    {"tool": "read_freertos", "args": {"what": "heap"}},
    {"tool": "track_variable", "args": {"action": "start", "variable": "HEAP_FREE_SYMBOL", "interval_ms": 500}},
    {"tool": "continue_execution", "args": {}},
    {"tool": "track_variable", "args": {"action": "get"}},
    {"tool": "read_freertos_heap", "args": {}}
  ]
}
