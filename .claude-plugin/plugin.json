{
  "name": "stm32-debug-kit",
  "displayName": "STM32 Debug Kit",
  "version": "0.4.1",
  "description": "Autonomous STM32 hardware debugging for AI agents: the stm32-gdb-mcp server (GDB + OpenOCD/ST-Link/J-Link) plus skills for the debug loop and write-time SWO/ITM instrumentation. A SessionStart hook locks the golden rules in at conversation start.",
  "author": { "name": "Zeraissh", "url": "https://github.com/Zeraissh/stm32-gdb-mcp" },
  "homepage": "https://github.com/Zeraissh/stm32-gdb-mcp",
  "repository": "https://github.com/Zeraissh/stm32-gdb-mcp",
  "license": "MIT",
  "keywords": ["stm32", "embedded", "debugging", "gdb", "openocd", "swo", "cortex-m"],
  "mcpServers": {
    "stm32-gdb-mcp": {
      "command": "python",
      "args": ["-m", "mcp_server.server"],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/src",
        "STM32_GDB_MCP_COMPACT": "1"
      }
    }
  }
}
